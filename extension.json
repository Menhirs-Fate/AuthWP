{
    "name": "AuthWP-MF",
    "version": "0.3.0",
    "author": ["Johan Hattne", "Dan Boyes - Tawa Group"],
    "descriptionmsg": "authwp-desc",
    "license-name": "MIT",
    "type": "other",
    "url": "https://www.mediawiki.org/wiki/Extension:AuthWP",
    "requires": {
        "MediaWiki": ">= 1.39"
    },
    "config": {
        "AuthWPPath": "..",
        "AuthWPPriority": "100",
        "AuthWPAllowedRoles": [],
        "AuthWPApiUrl": "",
        "AuthWPApiSecret": "",
        "AuthWPRoleMap": {},
        "AuthWPSSOEnabled": false,
        "AuthWPSSOStartUrl": ""
    },
    "AuthManagerAutoConfig": {
        "primaryauth": {
            "AuthWPAuthenticationProvider": {
                "class": "AuthWPAuthenticationProvider",
                "args": [],
                "sort": 100
            },
            "AuthWPSSOProvider": {
                "class": "AuthWPSSOProvider",
                "args": [],
                "sort": 110
            }
        }
    },
    "SpecialPages": {
        "RequestUsernameChange": "SpecialRequestUsernameChange",
        "ManageUsernameRequests": "SpecialManageUsernameRequests",
        "AuthWPReturn": "SpecialAuthWPReturn"
    },
    "AutoloadClasses": {
        "AuthWPRestClient": "includes/AuthWPAuthenticationProvider.php",
        "AuthWPAuthenticationProvider": "includes/AuthWPAuthenticationProvider.php",
        "AuthWPSessionProvider": "includes/AuthWPSessionProvider.php",
        "SpecialRequestUsernameChange": "includes/SpecialRequestUsernameChange.php",
        "SpecialManageUsernameRequests": "includes/SpecialManageUsernameRequests.php",
        "AuthWPSchemaHooks": "includes/AuthWPSchemaHooks.php",
        "AuthWPSSOProvider": "includes/AuthWPSSO.php",
        "AuthWPSSOBeginRequest": "includes/AuthWPSSO.php",
        "AuthWPSSOContinueRequest": "includes/AuthWPSSO.php",
        "AuthWPSSOHooks": "includes/AuthWPSSO.php",
        "SpecialAuthWPReturn": "includes/SpecialAuthWPReturn.php"
    },
    "ConfigRegistry": {
        "AuthWP": "GlobalVarConfig::newInstance"
    },
    "Hooks": {
        "UserLogout": ["AuthWPSessionProvider::onUserLogout"],
        "LoadExtensionSchemaUpdates": ["AuthWPSchemaHooks::onLoadExtensionSchemaUpdates"],
        "AuthChangeFormFields": ["AuthWPSSOHooks::onAuthChangeFormFields"]
    },
    "MessagesDirs": {
        "AuthWP": ["i18n"]
    },
    "SessionProviders": {
        "AuthWPSessionProvider": {
            "class": "AuthWPSessionProvider",
            "args": []
        }
    },
    "manifest_version": 1
}
